---
// The fallback backdrop, for a stage whose post has no art. Its tone is
// declared as `PAPER` in src/lib/stage.ts, which is what tells the caption to
// use dark ink — if this ever stops being pale, change it there too.
//
// A sheet of manila drawing paper, carrying the
// site's own spec the way a drawing carries its title block. Every line here
// has to stay true — it is a colophon, not decoration.
---

<div class="paper-sheet absolute inset-0">
  <div class="paper-grid absolute inset-0"></div>

  {
    /* Pencil marks on the sheet. Drawn, not photographed — the wobble is a
      displacement filter over clean paths, which is what keeps a hand-drawn
      look at any viewport size without shipping an image.

      Placed away from the bottom-left caption and the fan's own strip. The
      plane sits near the horizontal centre on purpose: the viewBox is sliced,
      so on a phone only the middle band survives and anything parked at an
      edge is cropped out entirely. */
  }
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1600 900"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <filter id="paper-pencil" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.035"
        numOctaves="3"
        seed="7"
        result="grain"></feTurbulence>
      <feDisplacementMap
        in="SourceGraphic"
        in2="grain"
        scale="3"
        xChannelSelector="R"
        yChannelSelector="G"></feDisplacementMap>
    </filter>

    <g class="paper-doodle" filter="url(#paper-pencil)">
      {
        /* A signature, in two strokes — the long one the hand makes without
          lifting, and the short flick that follows it. Written as beziers
          rather than traced from an image, so it scales with the sheet; the
          displacement filter above is what keeps it off a machine curve. It
          signs nothing and spells nothing. */
      }
      <path
        d="M300 430 C430 355 590 320 720 336 C660 405 545 500 470 585 C440 625 470 648 505 612 C524 562 542 498 566 498 C592 498 602 578 628 578 C656 578 664 534 690 534 C716 534 724 574 752 574 C778 574 786 550 812 550 C838 550 846 570 872 566 C888 562 898 550 908 530"
      ></path>
      <path
        d="M980 384 C1006 326 1016 294 1024 352 C1032 296 1050 282 1064 318 C1078 350 1104 354 1130 318"
      ></path>
    </g>
  </svg>

  <div class="paper-fibre absolute inset-0"></div>

  {
    /* Sits on the caption's own baseline, opposite corner. Hidden on narrow
      screens, where the fan takes the full width and there is no corner
      left to put it in. */
  }
  <div
    class="absolute right-6 bottom-[calc(var(--fan-peek)+2.5rem)] hidden text-right md:block"
  >
  </div>
</div>

<style>
  /* Graphite, not ink: a soft wash of the paper's own dark tone, so the marks
     sit *in* the sheet rather than printed on top of it. Round caps and joins
     are most of what reads as pencil. */
  .paper-doodle {
    fill: none;
    stroke: color-mix(in srgb, var(--color-paper-ink) 42%, transparent);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
