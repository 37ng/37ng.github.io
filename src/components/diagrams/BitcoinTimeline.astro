---
/**
 * The timeline widget's mount point.
 *
 * Both homes — the bitcoin stage and the bitcoin post — go through this rather
 * than the island directly, so the hydration directive stays one decision
 * instead of two. The epoch data is static, built into the bundle by
 * `scripts/generate-bitcoin-epochs.mjs` — nothing is fetched in the browser.
 */
import { BitcoinTimeline } from "./BitcoinTimeline";

interface Props {
  variant?: "stage" | "post";
}

const { variant = "post" } = Astro.props;
---

{
  /* client:visible — the widget only means anything once it is on screen, so
    its hydration should not compete with the stage art for the first paint. */
}
<BitcoinTimeline client:visible variant={variant} />
