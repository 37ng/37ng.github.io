---
import BaseLayout from "./BaseLayout.astro";
import { ThemeToggle } from "../components/ThemeToggle";

interface Props {
  id: string;
  title: string;
  description?: string;
  date: string;
  lastEdit?: string;
  github?: string;
  color?: string;
  /** Whether this post has its own hero art — a paper-sheet post (e.g. the
   * prologue) has no stage worth priming, so direct entry falls back to the
   * curated landing stage instead. */
  hasStageArt?: boolean;
}

const { id, title, description, date, lastEdit, github, color, hasStageArt } =
  Astro.props;
// Fraunces, like the title above it and the prose below it — this line sits
// between the two, and it was the only thing on the page still reading in the
// body sans. The stage caption and the fan's panel already set the same face.
const descriptionClass =
  "mt-3 font-[family-name:var(--font-display)] text-lg text-ink-300";
const headingClass =
  "font-[family-name:var(--font-display)] text-4xl font-semibold text-ink-50 leading-tight";
---

<BaseLayout title={title} description={description}>
  <!-- --accent set here (inline style always wins over the CSS default on the
       same element) drives every signal-colored hover/highlight below with
       this post's own color instead of the shared orange — see global.css.
       The id is what the light theme is scoped to (html[data-theme]:has(#post)),
       so it stays even though nothing else reads it now. -->
  <main
    id="post"
    data-post-id={hasStageArt ? id : undefined}
    class="mx-auto max-w-3xl px-6 py-16"
    style={`--accent: ${color ?? "var(--color-signal-500)"}`}
  >
    <a
      href="/"
      data-back-home
      class="font-mono text-xs text-ink-400 hover:text-[var(--accent,var(--color-signal-500))]"
      >&larr; esc</a
    >

    <header class="mt-8 mb-10 border-b border-ink-700 pb-8">
      {
        github && (
          <div class="flex justify-end mb-4">
            <a
              href={github}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-xs text-ink-400 hover:text-[var(--accent,var(--color-signal-500))] transition-colors"
            >
              repo &#8599;
            </a>
          </div>
        )
      }
      <h1 class={headingClass}>{title}</h1>
      {description && <p class={descriptionClass}>{description}</p>}
      <div class="mt-3 flex items-center justify-between">
        <time class="font-mono text-sm text-ink-400">
          {date}
          {lastEdit && lastEdit !== date && (
            <span class="text-ink-500"> &middot; updated {lastEdit}</span>
          )}
        </time>
        <ThemeToggle client:load />
      </div>
    </header>

    <article class="prose-tech">
      <slot />
    </article>
  </main>
</BaseLayout>

<script>
  // Escape leaves the post, same as clicking "back". Bound to the document
  // once and resolved against the DOM at press time rather than to this
  // page's link: the listener outlives a view transition, and a page with no
  // back link (the homepage, where Escape lowers the card fan instead) simply
  // finds nothing to click.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || event.defaultPrevented) return;
    document.querySelector<HTMLAnchorElement>("[data-back-home]")?.click();
  });

  // A reader who lands straight on a post (a shared link, a search result)
  // has no stage saved yet, so home's bootstrap would fall back to the fixed
  // landing stage on Escape — a different subject than the one just read.
  // Only fill the gap when it's empty: hovering a card in the fan already
  // saved this post's stage before the click that opened it, and that choice
  // must win. Re-read the post id from the DOM on every page-load (fired for
  // the first load and every soft navigation) rather than closing over it,
  // since the same module keeps running across post-to-post navigation. A
  // paper-sheet post (no hero art, e.g. the prologue) carries no data-post-id
  // at all, so this is a no-op there and home's own default takes over.
  function primeStage() {
    let id;
    try {
      if (sessionStorage.getItem("stage")) return;
      id = document.getElementById("post")?.dataset.postId;
      if (id) sessionStorage.setItem("stage", id);
    } catch {
      // Storage throws outright in some privacy modes.
    }
  }
  primeStage();
  document.addEventListener("astro:page-load", primeStage);
</script>
